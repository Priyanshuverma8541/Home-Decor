# Existing Savitri Livings backend variables belong here.
# SFMC checklist field guidance (server only)
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-3.8-flash
# Optional: server-side YouTube Data API key for title/duration on official player previews.
YOUTUBE_API_KEY=your_youtube_data_api_key
# Portfolio Studio uses the existing Savitri Pages system (keep server-side)
SAVITRI_PAGES_ORIGIN=https://home-decor-inky.vercel.app
PORTFOLIO_BUILDER_URL=https://home-decor-inky.vercel.app
PORTFOLIO_PUBLISHING_ENABLED=false
PORTFOLIO_LIVE_PAYMENTS_ENABLED=false
GEMINI_FALLBACK_MODELS=gemini-3.5-flash,gemini-3.5-flash-lite
# Career Growth is admin-only unless this identity is explicitly configured.
ARCHANA_CAREER_EMAIL=archana@example.com
ARCHANA_CAREER_PHONE=+91-0000000000
# SL Points are tracked in the app; purchases require manual UPI verification.
SL_POINTS_UPI_ID=
# Keep cash disbursements off until the program has been reviewed and approved.
SL_POINTS_CASHOUT_ENABLED=false
# Media Downloader: direct HTTPS media files only; value is bytes and is capped at 100 MiB.
MEDIA_DOWNLOADER_MAX_BYTES=104857600
# GitHub check_suite webhook verification. Set this same random secret in the GitHub webhook and Render.
GITHUB_WEBHOOK_SECRET=replace_with_a_long_random_secret
# BuildHub uses the shared Savitri Livings MongoDB, auth, and Cloudinary configuration.
# Optional SMTP_HOST / SMTP_PORT / SMTP_USER / SMTP_PASS enable order and enquiry email notifications.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME=Savitri Livings
